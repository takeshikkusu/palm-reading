# Palm AI - 環境変数サンプル
# コピー: cp .env.example .env のあと、値を編集してください。

# Gemini API（必須）
# https://aistudio.google.com/apikey で取得
GEMINI_API_KEY=your_gemini_api_key_here

# モデル名（任意・デフォルト: models/gemini-1.5-flash）
# google-generativeai SDK では "models/..." の形式が推奨
# GEMINI_MODEL=models/gemini-1.5-flash

# Flask
# FLASK_ENV=development

# CORS（本番でフロントのオリジンを指定する場合）
# カンマ区切りで複数指定可
# CORS_ORIGINS=https://your-app.onrender.com,https://www.example.com
